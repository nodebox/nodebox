        {
            "type": "code",
            "name": "makeMaze",
            "returnsList": true,
            "source": "maze.makeMaze = function (width, height, seed) {\n    var x, y, maze = [], row, trail = [];\n\n    var UP = [0, -1];\n    var DOWN = [0, 1];\n    var LEFT = [-1, 0];\n    var RIGHT = [1, 0];\n\n    for (y = 0; y < height; y++) {\n        row = [];\n        for (x = 0; x < width; x++) {\n            row.push(true);\n        }\n        maze.push(row);\n    }\n\n    var LIMIT = 5000;\n\n    function carve(x, y, dirX, dirY, seed) {\n        if (trail.length > LIMIT) return;\n        if (y < 0 || y >= height || x < 0 || x >= width) return;\n\n        // Check if the position can have a new hallway going to it.\n        if (maze[y][x]) {\n            // Make this position into a hallway.\n            maze[y][x] = false;\n            trail.push({x: x, y: y});\n\n            // Connect this position with the previous position.\n            maze[y - dirY][x - dirX] = false;\n            trail.push({x: x - dirX, y: y - dirY});\n\n            // Create a new directions list and randomize its order.\n            var directions = [UP, DOWN, LEFT, RIGHT];\n            g.shuffle(directions, seed + trail.length);\n\n            // Follow each direction.\n            for (var i = 0; i < directions.length; i++) {\n                dirX = directions[i][0];\n                dirY = directions[i][1];\n                carve(x + dirX * 2, y + dirY * 2, dirX, dirY, seed);\n            }\n        }\n\n    }\n\n    carve(Math.floor(width / 2), Math.floor(height / 2), 0, 0, seed);\n    return trail;\n};",
