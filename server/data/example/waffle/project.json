          "backgroundColor": {
            "r": 0.30196078431372547,
            "g": 0.48627450980392156,
            "b": 0.058823529411764705,
            "a": 0.8
          },
          "text": "The axes of a waffle plot only show the row and column indexes. Remove them to create a clean data visualization. Select Remove axis in the Other section. ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.9333333333333333,
            "g": 0.9333333333333333,
            "b": 0.9333333333333333,
            "a": 1
          }
        },
        {
