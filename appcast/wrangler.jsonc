{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serves /app/nodebox/appcast.xml, built from the GitHub releases of nodebox/nodebox (README.md).
  "name": "nodebox-appcast",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The URL every NodeBox since 3.0.50 checks. Cloudflare manages its DNS record and certificate.
  "routes": [{ "pattern": "secure.nodebox.net", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
  // Secret: GITHUB_TOKEN, from 1Password with `npm run secrets` (README.md). The account ID comes from
  // 1Password too (npm run deploy, npm run secrets); Workers Builds sets it itself.
}
