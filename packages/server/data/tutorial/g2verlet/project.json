        {
            "type": "code",
            "name": "verletInit",
            "source": "g2verlet.verletInit = function (inpoints, centre, joint, tocenter, spokeStiffness, treadStiffness) {\n    spokeStiffness /= 100;\n    treadStiffness /= 100;\n    var sim = new verletSimple.VerletJS(600, 450);\n    sim.friction = 1.019;\n    for (var i = 0; i < inpoints.length; i++) {\n        inpoints[i].x += sim.width / 2;\n        inpoints[i].y += sim.height / 2;\n    }\n    var an = sim.any(new verletSimple.Vec2(centre.x - sim.width / 2, centre.y - sim.height / 2), inpoints, spokeStiffness, treadStiffness, joint, tocenter);\n    return sim;\n};",
            "parameters": [
                {
                    "name": "inpoints",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    },
                    "takesList": true
                },
                {
                    "name": "centre",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    },
                    "takesList": false
                },
                {
                    "name": "joint",
                    "type": "float",
                    "value": 1,
                    "takesList": true
                },
                {
                    "name": "tocenter",
                    "type": "boolean",
                    "value": 1,
                    "takesList": false
                },
                {
                    "name": "spokeStiffness",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "treadStiffness",
                    "type": "float",
                    "value": 1
                }
            ],
            "outputType": "object",
            "stateful": false,
            "connections": []
        },
        {
            "type": "code",
            "name": "verletUpdate",
            "source": "g2verlet.verletUpdate = function (sim) {\n    sim.frame(25);\n    var all = sim.composites.length;\n    for (var a = 0; a < all; a++) {\n        for (var i = 0; i < sim.composites[a].constraints.length; i++) {\n            var distconst = sim.composites[a].constraints[i];\n            //console.log(distconst.a.pos.x);\n            //console.log(distconst, distconst instanceof g2verlet.DistanceConstraint);\n\n        }\n    }\n    return sim;\n};",
            "parameters": [
                {
                    "name": "sim",
                    "type": "object",
                    "value": 1
                }
            ],
            "connections": [],
            "returnsList": false,
            "stateful": true
        },
        {
            "type": "code",
            "name": "verletToPoints",
            "source": "g2verlet.verletToPoints = function (sim) {\n    var points = [];\n    var all = sim.composites.length;\n    for (var a = 0; a < all; a++) {\n        var particles = sim.composites[a].particles;\n        for (var i = 0; i < particles.length; i++) {\n            var pt = particles[i].pos;\n\n            points.push(new g.Point(pt.x - sim.width / 2, pt.y - sim.height / 2));\n        }\n    }\n    return points;\n\n};",
            "parameters": [
                {
                    "name": "sim",
                    "type": "object",
                    "value": "",
                    "takesList": false
                }
            ],
            "returnsList": true,
            "outputType": "point"
        }
