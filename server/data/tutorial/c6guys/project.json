            "name": "topoints",
            "source": "c6guys.topoints = function (shape) {\n   var points = [];\n  if(shape.segments){\n   for (var i = 0; i < shape.segments.length; i += 1) {\n     var seg = shape.segments[i];\n     if (seg.point) {\n         points.push(new g.Point(seg.point.x, seg.point.y));\n     }\n   }\n}\n   return points;\n};",
