        {
            "type": "code",
            "name": "partInit",
            "source": "g5particles.partInit = function () {\n    var l = [];\n    return l;\n};",
            "parameters": [],
            "returnsList": true,
            "outputType": ""
        },
        {
            "type": "code",
            "name": "partUpdate",
            "source": "g5particles.partUpdate = function (l) {\n    var cl = []\n    for (var i = 0; i < l.length; i++) {\n        var p = l[i];\n        p.x += p.sx;\n        p.y += p.sy;\n        var np = new g.Point(p.x, p.y);\n        np.sx = p.sx;\n        np.sy = p.sy;\n        np.s = p.s;\n        if (p.life > 0) {\n            np.life = p.life - 1;\n            cl.push(np);\n        }\n    }\n    return cl;\n};",
            "parameters": [
                {
                    "name": "l",
                    "type": "",
                    "value": "",
                    "takesList": true
                }
            ],
            "returnsList": true,
            "stateful": true,
            "outputType": ""
        },
        {
            "type": "code",
            "name": "partAdd",
            "source": "g5particles.partAdd = function (l, time,pos) {\n    if (l.length < 100) {\n        var np = new g.Point(pos.x,pos.y);\n        np.sx = 3.0 * (Math.random() - 0.5);\n        np.sy = 3.0 * (Math.random() - 0.5);\n        np.life = 100;\n        np.s = (1 + Math.random()) * 3.0;\n        l.push(np);\n    }\n    return l;\n};",
            "parameters": [
                {
                    "name": "l",
                    "type": "",
                    "value": 1,
                    "takesList": true
                },
                {
                    "name": "time",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "pos",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    }
                }
            ],
            "returnsList": true,
            "stateful": true
        }
