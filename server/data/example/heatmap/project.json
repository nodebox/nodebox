            "b": 0.5411764705882353,
            "a": 0.8
          },
          "text": "A heatmap displays data values as colors in a matrix. It provides an intuitive way to visualize patterns, correlations, or density across two dimensions. ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.15294117647058825,
            "g": 0.15294117647058825,
            "b": 0.16470588235294117,
            "a": 1
          }
        },
        {
          "id": "eal3AVOxj1S:4",
          "type": "STICKY",
          "x": 400,
          "y": 120,
          "width": 400,
          "height": 50,
          "backgroundColor": {
            "r": 0.9921568627450981,
            "g": 0.9019607843137255,
            "b": 0.5411764705882353,
            "a": 0.8
          },
          "text": "Load data from an online source. Original source: https://vega.github.io/vega-datasets/\ndata/seattle-weather-hourly-normals.csv",
          "fontSize": 12,
          "fontColor": {
            "r": 0.15294117647058825,
            "g": 0.15294117647058825,
            "b": 0.16470588235294117,
            "a": 1
          }
        },
        {
          "id": "eal3AVOxj1S:5",
          "type": "STICKY",
          "x": 400,
          "y": 180,
          "width": 400,
          "height": 50,
          "backgroundColor": {
            "r": 0.30196078431372547,
            "g": 0.48627450980392156,
            "b": 0.058823529411764705,
            "a": 0.8
          },
          "text": "The date is stored as a JavaScript Date object. Extract the hours of the date using the getHours() method. ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.9333333333333333,
            "g": 0.9333333333333333,
            "b": 0.9333333333333333,
            "a": 1
