        {
            "type": "code",
            "name": "pointcloud",
            "source": "f4projection.pointcloud = function (x, y, z, rotX, rotY, rotZ, persp) {\n\n    var Sx = g.sin(g.radians(rotX))\n    var Cx = g.cos(g.radians(rotX))\n    var Sy = g.sin(g.radians(rotY))\n    var Cy = g.cos(g.radians(rotY))\n    var Sz = g.sin(g.radians(rotZ))\n    var Cz = g.cos(g.radians(rotZ))\n\n    var x1 = Cy * (Sz * y + Cz * x) - Sy * z\n    var y1 = Sx * (Cy * z + Sy * (Sz * y + Cz * x)) + Cx * (Cz * y - Sz * x)\n    var z1 = Cx * (Cy * z + Sy * (Sz * y + Cz * x)) - Sx * (Cz * y - Sz * x)\n\n    var sca = persp.x\n    var fov = persp.y\n\n    var factor = sca / fov + z1\n\n    var x2 = factor * x1 * fov\n    var y2 = factor * y1 * -fov\n\n    return new g.Point(x2,y2);\n};",
            "parameters": [
                {
                    "name": "x",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "y",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "z",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "rotX",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "rotY",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "rotZ",
                    "type": "float",
                    "value": 1
                },
                {
