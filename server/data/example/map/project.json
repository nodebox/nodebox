            "b": 0.5411764705882353,
            "a": 0.8
          },
          "text": "A choropleth map is a type of thematic map in which areas are shaded or colored proportionally to a numerical variable. ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.15294117647058825,
            "g": 0.15294117647058825,
            "b": 0.16470588235294117,
            "a": 1
          }
        },
        {
          "id": "egih3UyNsS5:2",
          "type": "STICKY",
          "x": 400,
          "y": 120,
          "width": 370,
          "height": 50,
          "backgroundColor": {
            "r": 0.9921568627450981,
            "g": 0.9019607843137255,
            "b": 0.5411764705882353,
            "a": 0.8
          },
          "text": "Load the geographic reference data. Inspect the date in the Table or Detail view. This data has a nested topojson format. Inspect the geometries in objects.counties.",
          "fontSize": 12,
          "fontColor": {
            "r": 0.15294117647058825,
            "g": 0.15294117647058825,
            "b": 0.16470588235294117,
            "a": 1
          }
        },
        {
          "id": "egih3UyNsS5:3",
          "type": "STICKY",
          "x": 400,
          "y": 420,
