            "type": "code",
            "name": "life",
            "source": "life.life = function (world, width, height, fullness, seed) {\n\n    function isAlive(x, y) {\n        var cell = world[y * width + x];\n        return cell !== undefined ? cell.alive : false;\n    }\n\n    function updateCell(world, x, y){\n        var neighbors, dy, dx, alive;\n        neighbors = 0;\n        for (dy = -1; dy <= 1; dy++){\n            for (dx = -1; dx <= 1; dx++){\n                if (isAlive(x + dx, y + dy)) {\n                    neighbors += 1;\n                }\n            }\n        }\n        alive = isAlive(x, y);\n        if (alive) {\n            neighbors -= 1;\n        }\n    \n        if (alive && neighbors < 2) {\n            return false;\n        } else if (alive && neighbors > 3) {\n            return false;\n        } else if (!alive && neighbors === 3) {\n            return true;\n        } else {\n            return alive;\n        }\n    }\n\n    var rand, y, x, cell, pt, alive, newWorld;\n\n    rand = ndbx.randomGenerator(seed);\n    if (!world) {\n        world = [];\n        for (y = 0; y < height; y ++) {\n            for (x = 0; x < width; x ++) {\n                alive = rand(0, 100) < fullness;\n                pt = {x: x, y: y, alive: alive};\n                world.push(pt);\n            }\n        }\n        return world;\n    } else {\n        newWorld = [];\n        for (y = 0; y < height; y ++) {\n            for (x = 0; x < width; x ++) {\n                alive = updateCell(world, x, y);\n                pt = {x: x, y: y, alive: alive};\n                newWorld.push(pt);\n             }\n        }\n        return newWorld;\n    }\n};",
