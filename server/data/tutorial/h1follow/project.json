        {
            "type": "code",
            "name": "positionContainer",
            "source": "h1follow.positionContainer = function (po) {\nvar wave = g.sineWave(ndbx._currentFrame, -200,200,69);\nvar swave = g.sineWave(ndbx._currentFrame,-120.0,120.0,75);\nvar awave = g.sineWave(ndbx._currentFrame,-200.0,200.0,50);\n\nvar fwave = g.sineWave(ndbx._currentFrame,-100+awave,100+awave,100);\n    var pos = po;\n    if (pos.length < 120) {\n        pos.push(new g.Point(fwave,wave));\n    } else {\n        pos.splice(0,1);\n    }\n    return pos;\n};",
            "parameters": [
                {
                    "name": "po",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    },
                    "takesList": true
                }
            ],
            "stateful": true,
            "returnsList": true
        },
