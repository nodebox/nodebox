        {
            "type": "code",
            "name": "getPixels",
            "returnsList": true,
            "source": "mixels.getPixels = function (imageName, step) {\n    var image, imgWidth, imgHeight, canvas, ctx, pixels, stride, y, x, offset, r, g, b, a, outPixels;\n    image = ndbx.assets[imageName];\n    imgWidth = image.width;\n    imgHeight = image.height;\n    canvas = document.createElement('canvas');\n    canvas.width = image.width;\n    canvas.height = image.height;\n    ctx = canvas.getContext('2d');\n    ctx.drawImage(image, 0, 0, image.width, image.height);\n    pixels = ctx.getImageData(0, 0, image.width, image.height).data;\n    stride = image.width * 4;\n    outPixels = [];\n    for (y = 0; y < imgHeight; y += step) {\n        for (x = 0; x < imgWidth; x += step) {\n            offset = y * stride + x * 4;\n            r = pixels[offset];\n            g = pixels[offset + 1];\n            b = pixels[offset + 2];\n            a = pixels[offset + 3];\n            outPixels.push({x: x - imgWidth / 2, y: y - imgHeight / 2, \n                            r: r, g: g, b: b, a: a});\n        } \n    }\n    return outPixels;\n};",
            "parameters": [
                {
                    "name": "imageName",
                    "type": "string",
                    "value": "wolf.jpg"
                },
                {
                    "name": "step",
                    "type": "float",
                    "value": 20
                }
            ],
            "outputType": "point"
        },
