        {
            "type": "code",
            "name": "prism",
            "returnsList": true,
            "source": "simple.prism = function (word, alpha) {\n\n    function palette(colors) {\n        return _.map(colors, function (c) {\n            return {r: c[0], g: c[1], b:c[2], a:alpha};\n        });\n    }\n\n    var apple = [\n        [110,170,134],\n        [105,172,141],\n        [98,163,133],\n        [117,169,120],\n        [104,196,121],\n        [65,160,126]];\n    var smurf = [\n        [190,201,233],\n        [237,236,241],\n        [207,213,229],\n        [206,212,228],\n        [222,224,237],\n        [177,178,209]];\n    var jealousy = [\n        [203,164,1],\n        [122,94,44],\n        [141,149,30],\n        [210,167,0],\n        [137,122,37],\n        [228,243,0]];\n    var black = [\n        [0,0,0],\n        [255,255,255],\n        [255,255,255]];\n    if (word === 'apple') {\n        return palette(apple);\n    } else if (word === 'smurf') {\n        return palette(smurf);\n    } else if (word === 'black' || word === 'white') {\n        return palette(black);\n    } else {\n        return palette(jealousy);\n    }\n};",
            "example": "simple.prism(\"apple\", 255)",
            "parameters": [
                {
                    "name": "word",
                    "type": "string",
                    "value": "apple"
                },
                {
                    "name": "alpha",
                    "type": "float",
                    "value": 255
                }
            ]
        }
