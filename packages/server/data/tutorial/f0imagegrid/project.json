        {
            "type": "code",
            "name": "mix",
            "source": "f0imagegrid.mix = function (pt1, pt2, t) {\n    var x1, y1, x2, y2;\n    x1 = pt1.x;\n    y1 = pt1.y;\n    x2 = pt2.x;\n    y2 = pt2.y;\n    return new g.Point((x1+x2), (y1+y2));\n};",
            "example": "f0imagegrid.mix(42)",
