# Live service secrets are fetched from 1Password:
#   npm run setup-secrets          -> writes .env and .dev.vars (local dev uses the live JWT secret)
#   npm run setup-secrets:remote   -> uploads the worker secrets with wrangler
# Regular local development does not need 1Password: `npm run init` writes a local-only .dev.vars.

# App JWT session key. Must stay the same across deploys, or every user is logged out.
JWT_SECRET={{ op://NodeBox/4lbtgkjemxiafu7dhw3kldegxa/App/JWT_SECRET }}

# R2 API token (Object Read & Write on bucket nodeboxlive). Used by the --remote scripts only.
R2_ACCOUNT_ID={{ op://NodeBox/4lbtgkjemxiafu7dhw3kldegxa/R2/R2_ACCOUNT_ID }}
R2_ACCESS_KEY_ID={{ op://NodeBox/4lbtgkjemxiafu7dhw3kldegxa/R2/R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ op://NodeBox/4lbtgkjemxiafu7dhw3kldegxa/R2/R2_SECRET_ACCESS_KEY }}
