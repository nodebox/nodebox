        {
            "type": "code",
            "name": "d6filterdata.topoints",
            "source": "d6filterdata.topoints = function (shape) {\n  var points = [];\n  if(shape.segments){\n   for (var i = 0; i < shape.segments.length; i += 1) {\n     var seg = shape.segments[i];\n     if (seg.point) {\n         points.push(new g.Point(seg.point.x, seg.point.y));\n     }\n   }\n}\n   return points;\n};",
            "example": "d6filterdata.topoints(42)",
            "parameters": [
                {
                    "name": "shape",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true,
            "returnType": "point"
        }
