{
  "name": "@ndbx/server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-static.mjs && wrangler dev --port 3000",
    "build": "tsc --noEmit && node scripts/build-static.mjs",
    "deploy": "node scripts/build-static.mjs && wrangler deploy",
    "seed": "node scripts/seed-data.mjs --local",
    "seed:remote": "node scripts/seed-data.mjs --remote",
    "set-role": "node scripts/set-role.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-dev": "vitest --ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "marked": "^14.1.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@cloudflare/workers-types": "^4.20250914.0",
    "dotenv": "16.4.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2",
    "wrangler": "^4.58.0"
  }
}
