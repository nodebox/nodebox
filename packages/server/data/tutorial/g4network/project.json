        {
            "type": "code",
            "name": "structure",
            "source": "g4network.structure = function (n, move) {\n    for (var i = 0; i < n.length; i++) {\n        var np = n[i];\n        np.x += (Math.random() - 0.5) * move;\n        np.y += (Math.random() - 0.5) * move;\n    }\n    return n;\n};\n",
            "parameters": [
                {
                    "name": "n",
                    "type": "",
                    "value": 1,
                    "takesList": true
                },
                {
                    "name": "move",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true,
            "stateful": true
        },
        {
            "type": "code",
            "name": "addN",
            "source": "g4network.addN = function (l) {\n    if (ndbx._currentFrame % 60 == 1) {\n        var np = new g.Point((Math.random()-0.5)*200, (Math.random()-0.5)*200);\n        l.push(np);\n    }\n    return l\n};",
            "parameters": [
                {
                    "name": "l",
                    "type": "",
                    "value": 1,
                    "takesList": true
                }
            ],
            "returnsList": true,
            "stateful": true
        },
        {
            "type": "code",
            "name": "structuretoo",
            "source": "g4network.structuretoo = function (n,limit) {\n    for (var i = 0; i < n.length; i++) {\n        var np = n[i];\n        for (var j = 0; j < n.length; j++) {\n            var np2 = n[j];\n            var d = g.distance(np, np2);\n            if ((np != np2) && d < limit) {\n                np.x += (Math.random()-0.5)*5.0;\n                np.y += (Math.random()-0.5)*5.0;\n            }\n        }\n    }\n    return n;\n};",
            "parameters": [
                {
                    "name": "n",
                    "type": "",
                    "value": 1,
                    "takesList": true
                },
                {
                    "name": "limit",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true,
