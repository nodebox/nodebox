        },
        {
            "type": "code",
            "name": "noOverlap",
            "source": "g6avoidcontact.noOverlap = function (n,limit) {\n    for (var i = 0; i < n.length; i++) {\n        var np = n[i];\n        for (var j = 0; j < n.length; j++) {\n            var np2 = n[j];\n            var d = g.distance(np, np2);\n            if ((np != np2) && d < limit) {\n                np.x += (Math.random()-0.5)*5.0;\n                np.y += (Math.random()-0.5)*5.0;\n            }\n        }\n    }\n    return n;\n};",
            "parameters": [
                {
                    "name": "n",
                    "type": "",
                    "value": 1,
                    "takesList": true
                },
                {
                    "name": "limit",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true,
            "stateful": true
        },
        {
            "type": "code",
            "name": "addN",
            "source": "g6avoidcontact.addN = function (l,time) {\n    if (ndbx._currentFrame % time == 1) {\n        var np = new g.Point((Math.random()-0.5)*350, (Math.random()-0.5)*250);\n        l.push(np);\n    }\n    return l\n};",
            "parameters": [
                {
                    "name": "l",
                    "type": "",
                    "value": 1,
                    "takesList": true
                },
                {
