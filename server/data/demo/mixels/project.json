                    "type": "color",
                    "value": "{r: 1, g: 2, b:3}"
                }
            ],
            "source": "// Convert the incoming RGB value to a HSL object.\nmixels.toHsl = function (v) {\n    var hsl = g.color.rgb2hsl(v.r / 255, v.g / 255, v.b / 255);\n    return {\n        h: hsl[0],\n        s: hsl[1],\n        l: hsl[2]\n    };\n};",
            "ref": "",
            "category": ""
        },
        {
            "name": "toHexColor",
            "type": "code",
            "outputType": "float",
            "parameters": [
                {
                    "name": "v",
                    "type": "float",
                    "value": 42
                }
            ],
            "source": "// Convert the incoming RGB value to a hex color string.\n\nfunction _toHex(c) {\n    var hex = c.toString(16);\n    return hex.length === 1 ? '0' + hex : hex;\n}\n\nmixels.toHexColor = function (v) {\n    return '#' + _toHex(Math.round(v.r)) + _toHex(Math.round(v.g)) + _toHex(Math.round(v.b));\n};",
            "ref": "",
            "category": ""
        }
