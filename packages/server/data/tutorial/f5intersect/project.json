        {
            "type": "code",
            "name": "lineIntersect",
            "source": "/*\nThis example uses the js port by Kyle Phillips based on the original code by Karsten Schmidt\nsee https://github.com/hapticdata/toxiclibsjs/ for toxiclibs.js code\n*/\n\nf5intersect.lineIntersect = function (lines) {\n    var result = [];\n    for (var i = 0; i < lines.length; i++) {\n        var p1 = lines[i].commands[0];\n        var p2 = lines[i].commands[1];\n        var l = new toxi.geom.Line2D(new toxi.geom.Vec2D(p1.x, p1.y), new toxi.geom.Vec2D(p2.x, p2.y));\n        for (var j = 0; j < lines.length; j++) {\n            var pp1 = lines[j].commands[0];\n            var pp2 = lines[j].commands[1];\n            var m = new toxi.geom.Line2D(new toxi.geom.Vec2D(pp1.x, pp1.y), new toxi.geom.Vec2D(pp2.x, pp2.y));\n            var interse = toxi.geom.Line2D.LineIntersection();\n            interse = l.intersectLine(m);\n            if (interse.getType() == toxi.geom.Line2D.LineIntersection.Type.INTERSECTING) {\n                var pos = interse.getPos();\n                result.push(new g.Point(pos.x, pos.y));\n            }\n        }\n    }\n    return result;\n\n};",
            "parameters": [
                {
                    "name": "lines",
                    "type": "shape",
                    "value": 1,
                    "takesList": true
                }
            ],
            "outputType": "point",
            "returnsList": true
        }
    ],
    "id": "f5intersect"
