        {
            "type": "code",
            "name": "boxrotate",
            "source": "g1aboxrotate.boxrotate = function (amount, time) {\n    var increase = Math.PI * 2.0 / amount;\n    var angle = -Math.PI;\n    var plotcache = [];\n    var rx = 200 * Math.cos(time) + 200;\n    var ry = 50 * Math.sin(time) + 200;\n    for (var i = 0; i < amount; i++) {\n        var x = 100 * Math.cos(angle) + rx;\n        var y = 100 * Math.sin(angle) + ry;\n        x = g.clamp(x, 70, 320);\n        y = g.clamp(y, 70, 320);\n        var turnangle = Math.atan2(y - ry, x - rx) * 180 / Math.PI + 90;\n        var p = new g.Point(x, y);\n        p.rot = turnangle;\n        plotcache.push(p);\n        angle += increase;\n    }\n    return plotcache;\n};",
            "parameters": [
                {
                    "name": "amount",
                    "type": "int",
                    "value": 10
                },
                {
                    "name": "time",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true
        }
    ],
    "id": "g1aboxrotate"
