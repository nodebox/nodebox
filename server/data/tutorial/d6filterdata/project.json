        {
            "type": "code",
            "name": "d6filterdata.filter",
            "source": "d6filterdata.filter = function (data, key, op, value) {\n    if (_.isEmpty(value)) return data;\n    return _.filter(data, function (row) {\n        var obj = fastLookup(row, key);\n        if (op === '==' && obj == value) {\n            return true;\n        } else if (op === '!=' && obj != value) {\n            return true;\n        } else if (op === '>' && obj > value) {\n            return true;\n        } else if (op === '>=' && obj >= value) {\n            return true;\n        } else if (op === '<' && obj < value) {\n            return true;\n        } else if (op === '<=' && obj <= value) {\n            return true;\n        } else {\n            return false;\n        }\n    });\n};\n\nfastLookup = function (obj, key) {\n    if (obj === null || key === null) return null;\n    return obj[key];\n};",
            "example": "d6filterdata.filter(42)",
            "parameters": [
                {
                    "name": "data",
                    "type": "float",
                    "value": 1,
                    "takesList": true
                },
