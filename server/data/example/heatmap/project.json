            "a": 1
          }
        },
        {
          "id": "eamHGoE00yF:10",
          "type": "STICKY",
          "x": 400,
          "y": 540,
          "width": 400,
          "height": 50,
          "backgroundColor": {
            "r": 0.30196078431372547,
            "g": 0.48627450980392156,
            "b": 0.058823529411764705,
            "a": 0.8
          },
          "text": "The height of the rectangle can be defined by the height property or by the secondary y-coordinate. Use the relative band position 1 to set the y2 at the end of each band of the band scale. ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.9333333333333333,
            "g": 0.9333333333333333,
            "b": 0.9333333333333333,
            "a": 1
          }
        },
        {
          "id": "eamHGoE00yF:11",
