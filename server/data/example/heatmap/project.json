        },
        {
          "id": "eal3AVOxj1S:6",
          "type": "STICKY",
          "x": 400,
          "y": 240,
          "width": 400,
          "height": 50,
          "backgroundColor": {
            "r": 0.30196078431372547,
            "g": 0.48627450980392156,
            "b": 0.058823529411764705,
            "a": 0.8
          },
          "text": "Add data to the plot. Keep the default name \"table\". ",
          "fontSize": 12,
          "fontColor": {
            "r": 0.9333333333333333,
            "g": 0.9333333333333333,
            "b": 0.9333333333333333,
            "a": 1
