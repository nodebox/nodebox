{
  "name": "nodebox-appcast",
  "version": "0.1.0",
  "private": true,
  "description": "The update feed NodeBox checks, built from GitHub releases: a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "env": "op inject -f -i .env.template -o .env && chmod 600 .env",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "secrets": "op read 'op://NodeBox/NodeBox App/Appcast/GITHUB_TOKEN' | wrangler secret put GITHUB_TOKEN"
  },
  "dependencies": {
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
