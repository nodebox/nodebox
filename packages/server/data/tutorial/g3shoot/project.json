        {
            "type": "code",
            "name": "init",
            "source": "g3shoot.init = function (amount) {\n    var all = [];\n    for (var i = 0; i < amount; i++) {\n        var x = 360.0*(Math.random()-0.5);\n        var y = 360.0*(Math.random()-0.5);\n        var pt = new g.Point(x, y);\n        pt.speedx = 5.0*(Math.random()-0.5);\n        pt.speedy = 5.0*(Math.random()-0.5);\n        all.push(pt);\n    }\n    return all;\n};",
            "parameters": [
                {
                    "name": "amount",
                    "type": "float",
                    "value": 1
                }
            ],
            "returnsList": true,
            "outputType": "point"
        },
        {
            "type": "code",
            "name": "update",
            "source": "g3shoot.update = function (points) {\n    var tp = [];\n    for (var i = 0; i < points.length; i++) {\n        var tx = points[i].x + points[i].speedx;\n        var ty = points[i].y + points[i].speedy;\n        var pt = new g.Point(tx, ty);\n        if (tx > 200 || tx < -200) {\n            pt.speedx = -points[i].speedx;\n        } else {\n            pt.speedx = points[i].speedx;\n        }\n        if (ty > 200 || ty < -200) {\n            pt.speedy = -points[i].speedy;\n        } else {\n            pt.speedy = points[i].speedy;\n        }\n\n        tp.push(pt);\n    }\n    return tp;\n};",
            "parameters": [
                {
                    "name": "points",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    },
                    "takesList": true
                }
            ],
            "returnsList": true,
            "stateful": false
        }
    ],
