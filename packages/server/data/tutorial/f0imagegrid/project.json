                    "type": "float",
                    "value": 1
                },
                {
                    "name": "pt2",
                    "type": "float",
                    "value": 1
                },
                {
                    "name": "t",
                    "type": "float",
                    "value": 1
                }
            ]
        },
        {
            "type": "code",
            "name": "pixels",
            "source": "f0imagegrid.pixels = function (imageName, step) {\n    var image, imgWidth, imgHeight, canvas, ctx, pixels, stride, y, x, offset, r, g, b, a, outPixels;\n    image = ndbx.assets[imageName];\n    imgWidth = image.width;\n    imgHeight = image.height;\n    canvas = document.createElement('canvas');\n    canvas.width = image.width;\n    canvas.height = image.height;\n    ctx = canvas.getContext('2d');\n    ctx.drawImage(image, 0, 0, image.width, image.height);\n    pixels = ctx.getImageData(0, 0, image.width, image.height).data;\n    stride = image.width * 4;\n    outPixels = [];\n    outPixels.push(imgWidth/step);\n    for (y = 0; y < imgHeight; y += step) {\n        for (x = 0; x < imgWidth; x += step) {\n            offset = y * stride + x * 4;\n            r = pixels[offset];\n            g = pixels[offset + 1];\n            b = pixels[offset + 2];\n            a = pixels[offset + 3];\n            outPixels.push({x: x - imgWidth / 2, y: y - imgHeight / 2, \n                            r: r, g: g, b: b, a: a});\n        } \n    }\n    return outPixels;\n};",
            "example": "f0imagegrid.pixels(42)",
            "parameters": [
                {
                    "name": "imageName",
                    "type": "string",
                    "value": "8-carlos.jpeg"
                },
                {
                    "name": "step",
                    "type": "float",
                    "value": 20
                }
            ],
            "returnsList": true
        }
