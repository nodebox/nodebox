        {
            "type": "code",
            "name": "web",
            "source": "f02spider.web = function (segments, depth, radius, origin) {\n    var stride = (2.0 * Math.PI) / segments;\n    var n = segments * depth;\n    var radiusStride = radius / n;\n    var p = [];\n\n    for (var i = 0; i < n; ++i) {\n        var theta = i * stride + Math.cos(i * 0.4) * 0.05 + Math.cos(i * 0.05) * 0.2;\n        var shrinkingRadius = radius - radiusStride * i + Math.cos(i * 0.1) * 15;\n        var offy = Math.cos(theta * 2.1) * (radius / depth) * 0.2;\n\n        p.push(new g.Point(origin.x + Math.cos(theta) * shrinkingRadius, origin.y + Math.sin(theta) * shrinkingRadius + offy));\n    }\n\n\n    return p;\n};",
            "parameters": [
                {
                    "name": "segments",
                    "type": "float",
                    "value": 20
                },
