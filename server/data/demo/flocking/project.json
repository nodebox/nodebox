        {
            "name": "boid",
            "type": "code",
            "outputType": "float",
            "parameters": [
                {
                    "name": "position",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    }
                },
                {
                    "name": "velocity",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    }
                },
                {
                    "name": "acceleration",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    }
                },
                {
                    "name": "maxspeed",
                    "type": "float",
                    "value": 3
                },
                {
                    "name": "maxforce",
                    "type": "float",
                    "value": 0.05
                }
            ],
            "source": "class Boid {\n    constructor(position, velocity, acceleration, maxspeed, maxforce) {\n        this.position = position !== undefined ? position : g.Vec2.ZERO;\n        this.velocity = velocity !== undefined ? velocity : g.Vec2.ZERO;\n        this.acceleration = acceleration !== undefined ? acceleration : g.Vec2.ZERO;\n        this.maxspeed = maxspeed !== undefined ? maxspeed : 3;\n        this.maxforce = maxforce !== undefined ? maxforce : 0.05;\n    }\n\n    applyForce(force) {\n        // We could add mass here if we want A = F / M\n        return new Boid(this.position, this.velocity, this.acceleration.add(force), this.maxspeed, this.maxforce);\n    }\n\n    seek(target) {\n        const desired = target\n            .subtract(this.position) // A vector pointing from the location to the target\n            .normalize()\n            .multiply(this.maxspeed);\n        return desired\n            .subtract(this.velocity) // Steering = Desired minus Velocity\n            .limit(this.maxforce); // Limit to maximum steering force\n    }\n}\n\nflocking.boid = function (position, velocity, acceleration, maxspeed, maxforce) {\n    return new Boid(position, velocity, acceleration, maxspeed, maxforce);\n};",
            "ref": "",
            "category": ""
        },
        {
            "name": "flock",
            "type": "code",
            "outputType": "data",
            "parameters": [
                {
                    "name": "template",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    },
                    "takesList": true
                },
                {
                    "name": "maxspeed",
                    "type": "float",
                    "value": 3
                },
                {
                    "name": "maxforce",
                    "type": "float",
                    "value": 0.05
                }
            ],
            "source": "flocking.flock = function (template, maxspeed, maxforce) {\n    const boids = [];\n    if (ndbx._currentFrame === 1 && template) {\n        for (let i = 0; i < template.length; i += 1) {\n            let boid = flocking.boid(template[i], g.Vec2.ZERO, g.Vec2.ZERO, maxspeed, maxforce);\n            boids.push(boid);\n        }\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "update",
            "type": "code",
            "outputType": "data",
            "parameters": [
                {
                    "name": "flock",
                    "type": "data",
                    "value": "",
                    "takesList": true
                }
            ],
            "source": "flocking.update = function (flock) {\n    const boids = [];\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let velocity = boid.velocity\n        \t.add(boid.acceleration)\n        \t.limit(boid.maxspeed); // Limit speed\n        let position = boid.position.add(velocity);\n        boids.push(flocking.boid(position, velocity, g.Vec2.ZERO, boid.maxspeed, boid.maxforce));\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "goal",
            "type": "code",
            "outputType": "float",
            "parameters": [
                {
                    "name": "flock",
                    "type": "float",
                    "value": 0,
                    "takesList": true
                },
                {
                    "name": "target",
                    "type": "point",
                    "value": {
                        "x": 0,
                        "y": 0
                    }
                },
                {
                    "name": "strength",
                    "type": "float",
                    "value": 1
                }
            ],
            "source": "flocking.goal = function (flock, target, strength) {\n    const boids = [];\n    target = new g.Vec2(target.x, target.y);\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let goal = boid.seek(target).multiply(strength);\n        boids.push(boid.applyForce(goal));\n    }\n    return boids;\n};\n\n\n",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "separate",
            "type": "code",
            "outputType": "data",
            "parameters": [
                {
                    "name": "flock",
                    "type": "data",
                    "value": 1,
                    "takesList": true
                }
            ],
            "source": "function separate(boid, boids) {\n    const desiredseparation = 25.0;\n    let steer = g.Vec2.ZERO;\n    let count = 0;\n    // For every boid in the system, check if it's too close\n    for (let i = 0; i < boids.length; i += 1) {\n        let other = boids[i];\n        let d = boid.position.distanceTo(other.position);\n        // If the distance is greater than 0 and less than an arbitrary amount (0 when you are yourself)\n        if (d > 0 && d < desiredseparation) {\n            // Calculate vector pointing away from neighbor\n            let diff = boid.position\n                .subtract(other.position)\n                .normalize()\n                .divide(d);        // Weight by distance\n            steer = steer.add(diff);\n            count += 1;            // Keep track of how many\n        }\n    }\n    // Average -- divide by how many\n    if (count > 0) {\n        steer = steer.divide(count);\n    }\n\n    // As long as the vector is greater than 0\n    if (steer.magnitude() > 0) {\n        // Implement Reynolds: Steering = Desired - Velocity\n        steer = steer\n            .normalize()\n            .multiply(boid.maxspeed)\n            .subtract(boid.velocity)\n            .limit(boid.maxforce);\n    }\n    return steer;\n}\n\nflocking.separate = function (flock) {\n    const boids = [];\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let sep = separate(boid, flock).multiply(1.5);\n        boids.push(boid.applyForce(sep));\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "align",
            "type": "code",
            "outputType": "float",
            "parameters": [
                {
                    "name": "flock",
                    "type": "data",
                    "value": "",
                    "takesList": true
                }
            ],
            "source": "function align(boid, boids) {\n    const neighbordist = 50;\n    let sum = g.Vec2.ZERO;\n    let count = 0;\n    for (let i = 0; i < boids.length; i += 1) {\n        let other = boids[i];\n        let d = boid.position.distanceTo(other.position);\n        if (d > 0 && d < neighbordist) {\n            sum = sum.add(other.velocity);\n            count += 1;\n        }\n    }\n    if (count > 0) {\n      sum = sum\n          .divide(count)\n          .normalize()\n          .multiply(boid.maxspeed);\n      return sum // Steering\n          .subtract(boid.velocity)\n          .limit(boid.maxforce);\n    } else {\n        return g.Vec2.ZERO;\n    }\n}\n\nflocking.align = function (flock) {\n    const boids = [];\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let ali = align(boid, flock);\n        boids.push(boid.applyForce(ali));\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "cohesion",
            "type": "code",
            "outputType": "data",
            "parameters": [
                {
                    "name": "flock",
                    "type": "data",
                    "value": "",
                    "takesList": true
                },
                {
                    "name": "maxspeed",
                    "type": "float",
                    "value": 3
                },
                {
                    "name": "maxforce",
                    "type": "float",
                    "value": 0.05
                }
            ],
            "source": "function cohesion(boid, boids) {\n    const neighbordist = 50;\n    let sum = g.Vec2.ZERO; // Start with empty vector to accumulate all locations\n    let count = 0;\n    for (let i = 0; i < boids.length; i += 1) {\n        let other = boids[i];\n        let d = boid.position.distanceTo(other.position);\n        if (d > 0 && d < neighbordist) {\n            sum = sum.add(other.position); // Add location\n            count += 1;\n        }\n    }\n    if (count > 0) {\n        sum = sum.divide(count);\n        return boid.seek(sum); // Steer towards the location\n    } else {\n        return g.Vec2.ZERO;\n    }\n}\n\nflocking.cohesion = function (flock) {\n    const boids = [];\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let coh = cohesion(boid, flock);\n        boids.push(boid.applyForce(coh));\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
        {
            "name": "constrain",
            "type": "code",
            "outputType": "data",
            "parameters": [
                {
                    "name": "flock",
                    "type": "data",
                    "value": "",
                    "takesList": true
                },
                {
                    "name": "bounding",
                    "type": "shape",
                    "value": ""
                },
                {
                    "name": "strength",
                    "type": "ratio",
                    "value": 1
                },
                {
                    "name": "seed",
                    "type": "float",
                    "value": 0
                }
            ],
            "source": "flocking.constrain = function (flock, bounding, strength, seed) {\n    const boids = [];\n    const random = ndbx.randomGenerator(seed);\n    let x, y, width, height;\n    if (!bounding.bounds) {\n        return flock;\n    }\n    const bounds = bounding.bounds();\n\tx = bounds.x;\n    y = bounds.y;\n    width = bounds.width;\n    height = bounds.height;\n    for (let i = 0; i < flock.length; i += 1) {\n        let boid = flock[i];\n        let pos = boid.position;\n        let vx = boid.velocity.x;\n        let vy = boid.velocity.y;\n        let dx = random(width * (1 - strength));\n        let dy = random(height * (1 - strength));\n        if (pos.x < x - dx) { vx += dx; }\n        if (pos.y < y - dy) { vy += dy; }\n        if (pos.x > x + width + dx) { vx -= dx; }\n        if (pos.y > y + height + dy) { vy -= dy; }\n        boids.push(flocking.boid(boid.position, new g.Vec2(vx, vy), g.Vec2.ZERO, boid.maxspeed, boid.maxforce));\n    }\n    return boids;\n};",
            "ref": "",
            "category": "",
            "returnsList": true
        },
